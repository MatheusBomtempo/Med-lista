# Copy this file to .env and fill in your own values. Never commit .env.

# Firebase (Project settings > General > Your apps)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Google reCAPTCHA v2 site key (public key only, never the secret key)
REACT_APP_RECAPTCHA_SITE_KEY=

# Number for the floating WhatsApp button
REACT_APP_WHATSAPP_NUMBER=

# Server side only (read by the Netlify function, never exposed to the browser)
INFOSIMPLES_TOKEN=
# INFOSIMPLES_API_URL=
